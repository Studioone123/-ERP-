<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.erp</groupId>
    <artifactId>erp-system</artifactId>
    <version>1.0.0</version>
    <name>erp-system</name>
    <description>轻量级 ERP 管理系统（进销存 + 业财一体化 + 可选 Redis / Spring Cloud 能力）</description>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <!--
            Spring Boot 3.5.x 对应的 Spring Cloud 版本列车是 2025.0.x (Northfields)。
            2025.1.x 对应 Boot 4.x，不能混用，否则会出现 NoSuchMethodError 之类的诡异错误。
            版本对照见 https://spring.io/projects/spring-cloud 的 "Release Train Spring Boot compatibility" 表。
        -->
        <spring-cloud.version>2025.0.3</spring-cloud.version>
        <!-- springdoc 2.8.x 支持 Boot 3.4/3.5；2.9+ 起要求 Boot 3.5 以上，这里锁定已验证版本 -->
        <springdoc.version>2.8.17</springdoc.version>
        <poi.version>5.4.1</poi.version>
        <!-- 只取 BCrypt 算法实现，不引入整套 Spring Security 过滤器链 -->
        <spring-security-crypto.version>6.5.11</spring-security-crypto.version>
    </properties>

    <!--
        BOM 只做「版本管理」，不引入任何 jar。
        好处：下面各 Spring Cloud 依赖都不用写 <version>，版本一定与 Boot 3.5.16 对齐。
    -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <!-- Jakarta Bean Validation：@NotBlank / @Size / @Min 等声明式参数校验 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- 默认数据库：文件型 H2，零安装、重启数据不丢 -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- 切换到 MySQL 时使用的驱动（默认 profile 不会加载连接） -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ===== 可选能力：Redis =====
             依赖在 classpath 上并不等于「启用」：Lettuce 连接工厂是懒连接，
             默认 profile 不去读写 Redis，所以没有 Redis 的机器照样能双击 start.bat 运行。
             真正启用需要在启动参数里指定 redis profile。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- ===== 可选能力：Spring Cloud =====
             单体里挑的是「不需要注册中心 / 配置中心也能独立工作」的组件：
             OpenFeign（声明式服务调用）、Resilience4J（熔断降级）、Actuator（可观测性）。
             Spring Cloud Gateway / Eureka / Config Server 需要额外进程，见《架构演进.md》。 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-circuitbreaker-resilience4j</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- ===== 接口文档：springdoc-openapi =====
             启动后访问 /swagger-ui/index.html 与 /v3/api-docs。
             它只是扫描 Controller 生成文档，不参与任何业务逻辑，默认模式也能用。 -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- ===== Excel 导出：Apache POI（只做 xlsx，不引 xls 的额外模块） ===== -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>${poi.version}</version>
        </dependency>

        <!-- ===== 密码哈希：BCrypt =====
             单独引 spring-security-crypto（约 100KB），而不是 spring-boot-starter-security，
             这样不会自动给所有接口套上 Spring Security 的过滤器链，保持自定义 Token 鉴权不变。 -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
            <version>${spring-security-crypto.version}</version>
        </dependency>

        <!-- ===== 测试：JUnit 5 + MockMvc + AssertJ，仅 test scope，不进最终 jar ===== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>erp-system</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!--
                surefire 默认就会跑 *Test.java；显式声明是为了让 CI 里
                mvn test 一定输出中文可读的测试结果，且不因历史残留结果跳过。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <useSystemClassLoader>false</useSystemClassLoader>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
